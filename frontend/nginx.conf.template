# Template: at startup the image fills in ${BACKEND_URL} and ${NGINX_LOCAL_RESOLVERS}, every lowercase $name is nginx's.

# Scheme the client used, as told by the proxy in front, or this connection's when nothing is in front.
map $http_x_forwarded_proto $forwarded_proto {
	default $http_x_forwarded_proto;
	"" $scheme;
}

server {
	# Unprivileged image: the worker cannot bind a port below 1024.
	listen 8080;
	server_name _;
	root /usr/share/nginx/html;
	index index.html;
	# No nginx version in the Server header and error pages.
	server_tokens off;

	gzip on;
	gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

	# Private family notebook: never indexed. Headers are repeated in each location because add_header
	# does not inherit. HSTS belongs to whatever terminates HTTPS in front.
	add_header X-Robots-Tag "noindex, nofollow" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-Frame-Options "DENY" always;
	add_header Referrer-Policy "strict-origin-when-cross-origin" always;

	# Resolved per request, so nginx starts and answers even while the backend is down or not created yet.
	resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
	set $backend ${BACKEND_URL};

	# One origin for the whole app: whatever sits in front only routes the domain to this port.
	# Unbuffered responses, so the notebook export streams through instead of filling /tmp.
	location /api/ {
		# Largest recording (app.recording.max-bytes): bigger is refused before reaching the API.
		client_max_body_size 2m;
		proxy_pass $backend;
		proxy_http_version 1.1;
		proxy_buffering off;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $forwarded_proto;
		add_header X-Robots-Tag "noindex, nofollow" always;
		error_page 502 504 = @backend-down;
	}

	# Public uptime probe: the API and its database.
	location = /readyz {
		proxy_pass $backend;
	}

	# Backend unreachable: a JSON 503 rather than an HTML error page, so the app shows its outage band.
	location @backend-down {
		default_type application/json;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "no-store" always;
		return 503 '{"status":503,"code":"UNAVAILABLE","detail":"The notebook server is not running."}';
	}

	# Liveness of nginx for the Docker healthcheck and the uptime probe; kept out of the access log.
	location = /healthz {
		access_log off;
		default_type text/plain;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header Cache-Control "no-store" always;
		return 200 'ok';
	}

	# Hashed bundles and self-hosted fonts never change under a given URL. Cache-Control without
	# `always`: a bundle gone with a deployment answers a 404 that must not be cached for a year.
	location ~* \.(?:js|css|woff2)$ {
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "public, max-age=31536000, immutable";
	}

	# Images and animations: a missing one is a 404, never the SPA shell served as an image.
	location /assets/ {
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Cache-Control "no-cache" always;
		try_files $uri =404;
	}

	# SPA shell: names the hashed bundles, so never cached; unknown paths fall back to it.
	# CSP limits the damage of an XSS. Styles need 'unsafe-inline' for Angular component styles;
	# media-src allows blob: so a fresh recording can be played back before it is uploaded.
	# Permissions-Policy grants the microphone to this origin only, for the recording screen.
	location / {
		add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
		add_header Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()" always;
		add_header X-Robots-Tag "noindex, nofollow" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "DENY" always;
		add_header Referrer-Policy "strict-origin-when-cross-origin" always;
		add_header Cache-Control "no-cache" always;
		try_files $uri /index.html;
	}
}
