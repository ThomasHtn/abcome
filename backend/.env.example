# PostgreSQL connection: a dedicated role and database, on the native local install in development
# and on the VPS instance in production.
DB_URL=jdbc:postgresql://localhost:5432/littlewords
DB_USERNAME=littlewords
DB_PASSWORD=change-me

# Argon2id hash of the family passphrase, unquoted (see README.md, "Family password"). Required.
FAMILY_PASSWORD_HASH=$argon2id$v=19$m=32768,t=3,p=1$replace-with-your-salt$replace-with-your-hash

# Argon2id hash of the read-only passphrase, unquoted, for relatives who only look. Optional: empty turns it off.
READER_PASSWORD_HASH=

# First name of the child, shown in the notebook after login only. Required.
CHILD_NAME=Alix

# Swagger UI at /swagger-ui.html. Local development only: the document maps every route.
API_DOCS_ENABLED=true

# Turns the login lockout off, so repeated wrong passwords never block you: development only, never in production.
LOGIN_LOCKOUT_ENABLED=false

# Keep `native` behind a proxy: `framework` trusts a client-sent `Forwarded` header and defeats the lockout.
FORWARD_HEADERS_STRATEGY=native
