# =============================================================================
# Local development settings: `cp .env.example .env` and the backend starts as is.
# Demo passphrase of the hash below: littlewords-demo-passphrase. Never deploy it (deploy/.env.example).
# =============================================================================

# =============================================================================
# Database
# =============================================================================
# PostgreSQL of compose.yaml (`make db`), published on 5433 so it never clashes with a native install.
# Native PostgreSQL instead: jdbc:postgresql://localhost:5432/littlewords and your role's password.
DB_URL=jdbc:postgresql://localhost:5433/littlewords
DB_USERNAME=littlewords
DB_PASSWORD=littlewords

# =============================================================================
# Family
# =============================================================================
# Argon2id hash of the family passphrase, unquoted (backend/README.md, "Family password"). Required.
FAMILY_PASSWORD_HASH=$argon2id$v=19$m=32768,t=3,p=1$V2E0TkdoUUhuWUR1NU9CaVE5djY3Y0FT$w0JVNy5UQfAna7a78KzCyXNVTCd5OWq8c7Df+SCeC0Y

# Argon2id hash of the read-only passphrase, unquoted, for relatives who only look. Optional: empty turns it off.
READER_PASSWORD_HASH=

# First name of the child, shown in the notebook after login only. Required.
CHILD_NAME=Alix

# Name of the app on the login screen and in the page titles, one per family. Defaults to ABCome.
APP_NAME=ABCome

# End of APP_NAME drawn in the accent colour on the login screen; empty for none. Defaults to ome.
APP_NAME_ACCENT=ome

# IANA zone of the family, in which "today" is judged by the API and the app. Defaults to Europe/Paris.
APP_TIME_ZONE=Europe/Paris

# =============================================================================
# Development switches
# =============================================================================
# Swagger UI at /swagger-ui.html. Local development only: the document maps every route.
API_DOCS_ENABLED=true

# Turns the login lockout off, so repeated wrong passwords never block you: development only, never in production.
LOGIN_LOCKOUT_ENABLED=false

# Keep `native` behind a proxy: `framework` trusts a client-sent `Forwarded` header and defeats the lockout.
FORWARD_HEADERS_STRATEGY=native
