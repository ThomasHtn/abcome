# PostgreSQL connection (a dedicated database and role on the VPS instance in production).
DB_URL=jdbc:postgresql://localhost:5432/abcome
DB_USERNAME=abcome
DB_PASSWORD=change-me

# Swagger UI at /swagger-ui.html. Local development only: the document maps every route.
API_DOCS_ENABLED=true

# Keep `framework` behind Traefik, or every caller shares the proxy address in rate limits.
FORWARD_HEADERS_STRATEGY=framework
