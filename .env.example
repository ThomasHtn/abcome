# Production settings for docker-compose.prod.yml. Development uses backend/.env instead.

# Public host served by Traefik.
PUBLIC_HOST=abcome.thomashtn.dev

# Existing Traefik on the VPS: its Docker network, HTTPS entrypoint and certificate resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Docker network through which the backend reaches the VPS PostgreSQL 17.
DATABASE_NETWORK=database

# Dedicated database and role on that PostgreSQL (host is its container name on DATABASE_NETWORK).
DB_URL=jdbc:postgresql://postgres:5432/littlewords
DB_USERNAME=littlewords
DB_PASSWORD=change-me

# Argon2id hash of the family passphrase, in single quotes so Compose leaves its $ signs alone.
# How to produce it: backend/README.md, "Family password". Required: the backend refuses to start without it.
FAMILY_PASSWORD_HASH='$argon2id$v=19$m=32768,t=3,p=1$replace-with-your-salt$replace-with-your-hash'

# Argon2id hash of the read-only passphrase, for relatives who only look, in single quotes too.
# Optional: empty turns the reader sign-in off. Must be another passphrase than the family one.
READER_PASSWORD_HASH=

# First name of the child, shown in the notebook after login only. Required: the backend refuses to start without it.
CHILD_NAME=Alix

# Swagger UI stays off in production: the document maps every route.
API_DOCS_ENABLED=false
