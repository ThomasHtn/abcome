# =============================================================================
# Production settings: `cp .env.example .env && chmod 600 .env`, then fill every empty value.
# Values holding a $ (the Argon2 hashes) go between single quotes, so Compose leaves them alone.
# =============================================================================

# =============================================================================
# Site
# =============================================================================
# Domain of the notebook. Its DNS record must point at this machine, ports 80 and 443 open:
# Caddy gets and renews the certificate on its own.
DOMAIN=

# Registry of the images: your fork's owner on GHCR, lowercase.
IMAGE_REGISTRY=ghcr.io/thomashtn

# Image to run: a release (1.2.0), or a commit (sha-<full commit>) once its delivery is green.
# `main` follows the latest delivery: fine to try, pin a release in production.
IMAGE_TAG=main

# =============================================================================
# Secrets
# =============================================================================
# Database password, only ever used inside the internal network: `openssl rand -base64 24`.
DB_PASSWORD=

# Argon2id hash of the family passphrase, single-quoted: `make hash` (backend/README.md, "Family password").
FAMILY_PASSWORD_HASH=

# Same for the read-only passphrase, for relatives who only look. Empty turns it off.
READER_PASSWORD_HASH=

# =============================================================================
# Family
# =============================================================================
# First name of the child, shown after login only.
CHILD_NAME=
# Birth date of the child (yyyy-MM-dd), so the cards tell his age; empty shows dates instead.
CHILD_BIRTHDATE=

# Name of the app and its accented end, on the login screen and in the tab titles.
APP_NAME=ABCome
APP_NAME_ACCENT=ome

# IANA zone of the family, in which "today" is judged.
APP_TIME_ZONE=Europe/Paris

# =============================================================================
# Operations
# =============================================================================
# Backend logs as JSON for a log collector: ecs, logstash or gelf. Empty for plain text.
LOG_FORMAT=

# Published ports, for a machine where 80 and 443 are taken (Let's Encrypt then needs another challenge).
HTTP_PORT=80
HTTPS_PORT=443
