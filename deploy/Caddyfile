# Edge of the production template: HTTPS for {$DOMAIN}, /api and /readyz to the backend, the rest to nginx.
{
	# Nothing reconfigures Caddy at runtime, so its admin API stays closed.
	admin off
}

{$DOMAIN} {
	# Largest recording (raw audio body, app.recording.max-bytes): bigger is refused before reaching the API.
	request_body {
		max_size 2MiB
	}

	# HSTS belongs here, where HTTPS is terminated; nginx sets every other security header.
	header Strict-Transport-Security "max-age=31536000"

	# Caddy replaces any client-sent X-Forwarded-For, so the login lockout sees the real address.
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Public uptime probe: the API and its database.
	handle /readyz {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy frontend:8080
	}
}
